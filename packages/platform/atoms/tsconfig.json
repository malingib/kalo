{
  "extends": "@kalo/tsconfig/react-library.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./src/*"],
      "@kalo/lib": ["./../../lib"],
      "@kalo/lib/*": ["./../../lib/*"],
      "@kalo/features": ["./../../features"],
      "@kalo/features/*": ["./../../features/*"],
      "@kalo/prisma": ["./../../prisma"],
      "@kalo/dayjs": ["./../../dayjs"],
      "@kalo/prisma/*": ["./../../prisma/*"],
      "@kalo/dayjs/*": ["./../../dayjs/*"],
      "@kalo/platform-constants": ["./../constants/index.ts"],
      "@kalo/platform-types": ["./../types/index.ts"],
      "@kalo/platform-utils": ["./../constants/index.ts"],
      "@kalo/trpc": ["./../../trpc"],
      "@kalo/app-store": ["./../../app-store"],
      "@kalo/app-store/*": ["./../../app-store/*"],
      "@kalo/trpc/*": ["./../../trpc/*"]
    },
    "resolveJsonModule": true,
    "outDir": "./dist"
  },
  "include": [
    ".",
    "../../types/next-auth.d.ts",
    "../../types/next.d.ts",
    "../../types/@wojtekmaj__react-daterange-picker.d.ts",
    "../../types/business-days-plugin.d.ts",
    "../../types/window.d.ts",
    "../types",
    "../constants",
    "../utils",
    "../libraries",
    "../../dayjs",
    "../../prisma/zod-utils.ts",
    "../../prisma/zod",
    "../../features/eventtypes",
    "../../features/schedules",
    "../../features/bookings/Booker",
    "../../features/bookings/Booker",
    "../../features/instant-meeting",
    "../../features/bookings/handleMarkNoShow.ts",
    "../../features/bookings/types.ts",
    "../../features/bookings/lib",
    "../../features/components",
    "../../features/form-builder",
    "../../features/data-table",
    "../../kysely/types.ts",
    "./prisma-types/index.ts",
    "./kysely-types/index.ts",
    "../../lib/intervalLimits/intervalLimitSchema.ts"
  ],
  "exclude": [
    "dist",
    "build",
    "**/node_modules/**",
    "**/*WebWrapper.tsx",
    "**/*.docs.mdx",
    "**/*.stories.tsx",
    "monorepo.ts",
    "booker/export.ts",
    "booker/index.ts"
  ]
}
