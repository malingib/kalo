{
  "extends": "@kalo/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react",
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "dist",
    "paths": {
      "@kalo/embed-core": ["./../embed-core/src"],
      "@kalo/embed-react": ["./../embed-react/src"]
    }
  },
  "include": ["."],
  "exclude": ["dist", "build", "**/node_modules/**"]
}
