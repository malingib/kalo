{
  "extends": "@calcom/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react",
    "target": "ES2015",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "paths": {
      "src/*": ["./src/*"],
      "@calcom/embed-react": ["./../embed-react/src"],
      "@calcom/embed-snippet": ["./../embed-snippet/src"]
    }
  },
  "include": ["src", "env.d.ts", "index.ts", "*.ts"],
  "exclude": ["dist", "build", "**/node_modules/**"]
}
