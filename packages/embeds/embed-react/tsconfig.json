{
  "extends": "@kalo/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2015",
    "moduleResolution": "bundler",
    "declaration": true,
    "jsx": "preserve",
    "outDir": "dist",
    "paths": {
      "@kalo/embed-core": ["./../embed-core/src"],
      "@kalo/embed-snippet": ["./../embed-snippet/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "env.d.ts", "*.tsx", "*.ts"],
  // Exclude "test" because that has `api.test.ts` which imports @kalo/embed-react which needs it to be built using this tsconfig.json first. Excluding it here prevents type-check from validating test folder
  "exclude": ["**/node_modules/**", "test"]
}
